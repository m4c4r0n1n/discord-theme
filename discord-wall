#!/usr/bin/env bash
set -e
WALL="$HOME/.cache/hyde/wall.set"
THEME="$HOME/.config/vesktop/themes/hyde-wallpaper.theme.css"
mkdir -p "$(dirname "$THEME")"

REAL=$(readlink -f "$WALL")
case "${REAL,,}" in
  *.png)  MIME=image/png ;;
  *.webp) MIME=image/webp ;;
  *.gif)  MIME=image/gif ;;
  *)      MIME=image/jpeg ;;
esac
B64=$(base64 -w0 "$REAL")

cat > "$THEME" <<EOF
/**
 * @name HyDE Wallpaper
 */

/* Wallpaper on body, behind everything */
body:has(#app-mount)::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  background: url("data:${MIME};base64,${B64}") center/cover fixed no-repeat;
}

/* Strip backgrounds off the app shells so wallpaper passes through */
#app-mount,
#app-mount .app_a3002d,
#app-mount .app__160d8,
#app-mount .bg__960e4,
#app-mount .layer__960e4,
#app-mount .chat_f75fb0,
#app-mount .chatContent_f75fb0,
#app-mount .container_f37cb1,
#app-mount .container__2637a,
#app-mount .privateChannels_e6b769,
#app-mount .scroller__99e7c,
#app-mount .panels__5e434,
#app-mount .panels__5e434 > * {
  background: transparent !important;
}

/* Slight tint on the panels so they're readable against any wallpaper */
#app-mount .wrapper_ef3116,
#app-mount .sidebarList__5e434,
#app-mount .membersWrap_c8ffbb {
  background-color: rgba(var(--backgroundprimary), 0.30) !important;
}

/* Message bubble — only on the message itself, no row/avatar shifting */
#app-mount .message__5126c {
  background-color: rgba(var(--backgroundprimary), 0.55) !important;
  contain: unset;
}
.mouse-mode #app-mount .message__5126c:hover,
#app-mount .message__5126c.selected__5126c {
  background-color: rgba(var(--backgroundprimary), 0.75) !important;
}
EOF
echo "wrote $THEME"
